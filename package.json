{
    "name": "@dm/3d-director-desk",
    "version": "0.0.1",
    "packageManager": "bun@1.3.14",
    "description": "3D 导演台:游戏模型摆放、动作挂载、机位与预演输出(阶段一·基础实现)",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "registry": "https://npm.nie.netease.com",
        "access": "public"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "bun": ">=1.3.14"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -p tsconfig.build.json",
        "vercel-build": "vite build --mode playground",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src playground",
        "format": "prettier --write .",
        "storybook": "storybook dev -p 6087",
        "build-storybook": "storybook build",
        "artifact:clean": "rm -rf dist/test-assets dist/stories",
        "pack:check": "bun run artifact:clean && bun pm pack --dry-run",
        "release-check": "bun run typecheck && bun run lint && bun run build-storybook && bun run build && bun run pack:check",
        "prepack": "bun run artifact:clean",
        "prepublishOnly": "bun run release-check",
        "pa": "bun pm version patch && bun publish",
        "mi": "bun pm version minor && bun publish",
        "ma": "bun pm version major && bun publish",
        "alpha": "bun pm version prepatch --preid alpha && bun publish",
        "pre": "bun pm version prerelease --preid alpha && bun publish"
    },
    "peerDependencies": {
        "@react-three/drei": "^9.122.0",
        "@react-three/fiber": "^8.18.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "mobx": "^7.0.0",
        "mobx-react-lite": "^5.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "three": ">=0.184.0"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/js": "^10.0.1",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "@react-three/drei": "9.122.0",
        "@react-three/fiber": "8.18.0",
        "@storybook/react-vite": "10.5.10",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.4.0",
        "@types/react": "18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/three": "0.185.4",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-react": "6.1.1",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.5",
        "mobx": "7.0.3",
        "mobx-react-lite": "5.0.3",
        "prettier": "3.9.6",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "storybook": "10.5.10",
        "tailwindcss": "4.3.3",
        "three": "0.185.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.68.0",
        "vite": "8.2.2"
    },
    "dependencies": {
        "mediabunny": "^1.55.5"
    }
}
