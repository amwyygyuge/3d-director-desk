{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": false,
        "outDir": "dist",
        "stripInternal": true
    },
    "include": ["src"],
    "exclude": [
        "src/**/*.stories.ts",
        "src/**/*.stories.tsx",
        "src/**/stories/**",
        "playground",
        ".storybook",
        "public/test-assets"
    ]
}
